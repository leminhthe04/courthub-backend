NODE_ENV=development
PORT=8386
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courthub
DB_POOL_MAX=10
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8386/api/auth/google/callback
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=CourtHub <no-reply@courthub.io.vn>
RESEND_REPLY_TO=support@courthub.io.vn
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/en/payment/result
PAYOS_CANCEL_URL=http://localhost:3000/en/payment/result?cancelled=1
PAYOS_WEBHOOK_URL=http://localhost:8386/api/payments/webhook
PAYMENT_HOLD_MINUTES=15
